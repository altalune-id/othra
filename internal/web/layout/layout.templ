package layout

templ Layout(d LayoutData) {
	<!DOCTYPE html>
	<html lang={ d.lang() } data-theme="oagent-light">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ d.Title } · oagent</title>
			<link rel="icon" href={ d.Static("/favicon.ico") } sizes="any"/>
			<link rel="icon" type="image/png" sizes="32x32" href={ d.Static("/favicon-32x32.png") }/>
			<link rel="apple-touch-icon" href={ d.Static("/apple-touch-icon.png") }/>
			<link rel="stylesheet" href={ d.Static("/app.css") }/>
		</head>
		<body class="min-h-screen bg-base-200 text-base-content">
			<main class="flex min-h-screen items-center justify-center p-4">
				{ children... }
			</main>
		</body>
	</html>
}

templ Card(title string) {
	<div class="card w-full max-w-md bg-base-100 shadow-sm">
		<div class="card-body gap-4">
			<h1 class="card-title text-2xl">{ title }</h1>
			{ children... }
		</div>
	</div>
}
