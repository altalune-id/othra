package layout

import (
	"strconv"

	"altalune.id/oagent/password"
)

// PasswordFieldData names a new-password input and the inputs whose values it must not contain.
type PasswordFieldData struct {
	Name       string
	Label      string
	EmailInput string
	NameInput  string
}

templ PasswordField(d LayoutData, f PasswordFieldData) {
	<div class="flex flex-col gap-2" data-password-field data-email-input={ f.EmailInput } data-name-input={ f.NameInput }>
		<label class="floating-label">
			<span>{ f.Label }</span>
			<input class="input w-full" type="password" name={ f.Name } placeholder={ f.Label } autocomplete="new-password" minlength={ strconv.Itoa(password.MinLen) } required aria-describedby={ f.Name + "-rules" }/>
		</label>
		<progress class="progress w-full hidden" max="4" value="0" data-password-meter aria-label="Password strength"></progress>
		<p class="text-xs hidden" data-password-score aria-live="polite"></p>
		<ul id={ f.Name + "-rules" } class="text-xs text-base-content/70 list-disc pl-4" data-password-rules>
			<li data-rule="length">At least { strconv.Itoa(password.MinLen) } characters<span class="sr-only" data-rule-state></span></li>
			<li data-rule="common">Not a common or easy-to-guess password<span class="sr-only" data-rule-state></span></li>
			<li data-rule="personal">Doesn't contain your email or name<span class="sr-only" data-rule-state></span></li>
		</ul>
	</div>
	<script type="module" src={ d.Static("/password.js") }></script>
}
