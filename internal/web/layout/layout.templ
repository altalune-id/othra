package layout

templ Layout(d LayoutData) {
	<!DOCTYPE html>
	<html lang={ d.lang() } data-theme="othra-light" data-brand?={ d.Brand != nil }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ d.Title } · { d.siteName() }</title>
			<link rel="icon" href={ d.Static("/favicon.ico") } sizes="any"/>
			<link rel="icon" type="image/png" sizes="32x32" href={ d.Static("/favicon-32x32.png") }/>
			<link rel="apple-touch-icon" href={ d.Static("/apple-touch-icon.png") }/>
			<link rel="stylesheet" href={ d.Static("/app.css") }/>
			if d.Refresh != "" {
				<meta http-equiv="refresh" content={ "0;url=" + d.Refresh }/>
			}
			@brandStyle(d.Brand)
		</head>
		<body class="min-h-screen bg-base-100 text-base-content">
			<main class="flex min-h-screen items-center justify-center p-4">
				if d.Brand != nil {
					<div class="flex w-full max-w-100 flex-col items-center gap-6">
						@brandScope(d.Brand) {
							{ children... }
						}
						@brandFooter(d.Brand)
					</div>
				} else {
					{ children... }
				}
			</main>
		</body>
	</html>
}

templ Card(title string) {
	@CardWith(title, nil) {
		{ children... }
	}
}

// CardWith is Card with lead (an app mark) beside the title, in the title row.
templ CardWith(title string, lead templ.Component) {
	<div class="w-full max-w-100">
		<div class="flex flex-col gap-4">
			if b := brandFrom(ctx); b != nil {
				@BrandHeader(b)
			}
			if lead != nil {
				<div class="flex items-center gap-3">
					@lead
					<h1 class="text-2xl font-semibold break-words max-sm:text-xl">{ title }</h1>
				</div>
			} else {
				<h1 class="text-2xl font-semibold break-words max-sm:text-xl">{ title }</h1>
			}
			{ children... }
		</div>
	</div>
}

// Divider separates "Continue with Othra" from the password form below it.
templ Divider(label string) {
	<div class="divider my-0 text-xs text-base-content/70">{ label }</div>
}
