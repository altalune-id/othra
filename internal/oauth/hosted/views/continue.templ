package views

import (
	"altalune.id/othra/internal/web/i18n"
	"altalune.id/othra/internal/web/layout"
)

// ContinueData is the forwarding page after a hosted POST: Target is the validated authorize URL or client URI, Client the app's name.
type ContinueData struct {
	Site
	Client string
	Target string
}

func (v ContinueData) name() string {
	if v.Client != "" {
		return v.Client
	}
	return v.Project
}

func forwarding(d layout.LayoutData, target string) layout.LayoutData {
	d.Refresh = target
	return d
}

// Continue forwards the browser to Target from a GET, with a meta refresh and a visible link, so a POST never redirects off-site.
templ Continue(d layout.LayoutData, v ContinueData) {
	@layout.Layout(titled(forwarding(d, v.Target), i18n.T(ctx, "continue.title", "client", v.name()))) {
		@layout.Card(i18n.T(ctx, "continue.title", "client", v.name())) {
			<span class="loading loading-spinner loading-sm" aria-hidden="true"></span>
			<p role="status" class="text-sm text-base-content/70">{ i18n.T(ctx, "continue.body") }</p>
			<a class="btn btn-primary btn-block" href={ templ.SafeURL(v.Target) }>{ i18n.T(ctx, "continue.action", "client", v.name()) }</a>
		}
	}
}
