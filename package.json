{
  "name": "othra",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ui:mcp": "pnpm --filter @othra/base exec nuxt prepare && pnpm --filter @othra/mcp-ui build",
    "ui:console": "pnpm --filter @othra/console generate",
    "ui:portal": "pnpm --filter @othra/portal generate",
    "ui:test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@bufbuild/buf": "^1.75.0",
    "eslint": "^10.13.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "9.1.7",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "*.go": "scripts/lint/gofmt.sh",
    "*.{js,mjs,cjs,ts,mts,vue,json,md,css}": "eslint --fix --no-warn-ignored",
    "*.{yml,yaml}": "scripts/lint/tool.sh yamllint --strict -c .yamllint.yaml",
    "**/Dockerfile*": "scripts/lint/tool.sh hadolint",
    ".github/workflows/*.{yml,yaml}": "scripts/lint/tool.sh actionlint",
    "*.sh": "scripts/lint/tool.sh shellcheck",
    "api/**/*.proto": "sh -c 'pnpm exec buf lint' _"
  }
}
