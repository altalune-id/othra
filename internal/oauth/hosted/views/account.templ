package views

import (
	"net/url"

	"altalune.id/othra/internal/web/i18n"
	"altalune.id/othra/internal/web/layout"
)

// AccountData is the signed-in landing page's state; Google is nil when the project has no Google sign-in and the end user no Google identity.
type AccountData struct {
	Site
	Email        string
	UserSession  string
	ReturnTo     string
	SignOutToken string
	EmailLinkOff bool
	Google       *GoogleMethod
	Linked       bool
	Unlinked     bool
	Error        string
}

// GoogleMethod is the account page's Google row: the linked identity's public id and email (both empty when not linked) and the CSRF token of its form.
type GoogleMethod struct {
	Identity string
	Email    string
	Token    string
}

// Account is the M4 landing page for a signed-in end user: who is signed in, switch account and sign out.
templ Account(d layout.LayoutData, v AccountData) {
	@layout.Layout(titled(d, i18n.T(ctx, "account.title"))) {
		@layout.Card(i18n.T(ctx, "account.title")) {
			<div class="flex items-center gap-3 rounded-box bg-base-200 px-4 py-3">
				<span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-base-300 text-sm font-semibold" aria-hidden="true">{ initial(v.Email) }</span>
				<span class="min-w-0 break-all font-medium">{ v.Email }</span>
			</div>
			if v.Linked {
				@alertSuccess() {
					{ i18n.T(ctx, "account.linked") }
				}
			}
			if v.Unlinked {
				@alertSuccess() {
					if v.EmailLinkOff {
						{ i18n.T(ctx, "account.unlinked_plain") }
					} else {
						{ i18n.T(ctx, "account.unlinked") }
					}
				}
			}
			if v.Error != "" {
				@alertError(v.Error)
			}
			if v.Google != nil {
				@signInMethods(d, v)
			}
			<p class="text-sm text-base-content/70">{ i18n.T(ctx, "account.close_hint") }</p>
			<div class="flex flex-col gap-2 sm:flex-row">
				<a class="btn max-sm:btn-block" href={ templ.SafeURL(v.login(d, url.Values{"return_to": {v.href(d, "/account/")}})) }>{ i18n.T(ctx, "account.switch") }</a>
				<form method="post" action={ v.href(d, "/login/signout") }>
					@layout.CSRFInput(v.SignOutToken)
					<input type="hidden" name="user_session" value={ v.UserSession }/>
					<input type="hidden" name="next" value="signed_out"/>
					if v.ReturnTo != "" {
						<input type="hidden" name="return_to" value={ v.ReturnTo }/>
					}
					<button class="btn btn-ghost max-sm:btn-block" type="submit">{ i18n.T(ctx, "account.sign_out") }</button>
				</form>
			</div>
		}
	}
}

templ signInMethods(d layout.LayoutData, v AccountData) {
	<section class="flex flex-col gap-2" aria-labelledby="methods-title">
		<h2 id="methods-title" class="text-sm font-semibold">{ i18n.T(ctx, "account.methods_title") }</h2>
		<ul class="list rounded-box bg-base-200 text-sm">
			if !v.EmailLinkOff {
				<li class="list-row items-center">
					@iconMail("size-5")
					<span class="list-col-grow min-w-0">
						<span class="block font-medium">{ i18n.T(ctx, "account.method_email") }</span>
						<span class="block break-all text-base-content/70">{ v.Email }</span>
					</span>
				</li>
			}
			<li class="list-row items-center">
				@googleLogo()
				<span class="list-col-grow min-w-0">
					<span class="block font-medium">{ i18n.T(ctx, "account.method_google") }</span>
					if v.Google.Email != "" {
						<span class="block break-all text-base-content/70">{ v.Google.Email }</span>
					} else {
						<span class="block text-base-content/70">{ i18n.T(ctx, "account.not_linked") }</span>
					}
				</span>
				if v.Google.Identity != "" {
					<form method="post" action={ v.href(d, "/account/unlink") }>
						@layout.CSRFInput(v.Google.Token)
						<input type="hidden" name="identity" value={ v.Google.Identity }/>
						<button class="btn btn-ghost btn-sm" type="submit" aria-label={ i18n.T(ctx, "account.unlink_label") }>{ i18n.T(ctx, "account.unlink") }</button>
					</form>
				} else {
					<form method="post" action={ v.href(d, "/federation/google/start") }>
						@layout.CSRFInput(v.Google.Token)
						<input type="hidden" name="intent" value="link"/>
						<button class="btn btn-sm" type="submit">{ i18n.T(ctx, "account.link") }</button>
					</form>
				}
			</li>
		</ul>
	</section>
}

// SignedOutData is the signed-out page's state.
type SignedOutData struct {
	Site
}

// SignedOut confirms the sign-out and offers to sign in again.
templ SignedOut(d layout.LayoutData, v SignedOutData) {
	@layout.Layout(titled(d, i18n.T(ctx, "signed_out.title"))) {
		@layout.Card(i18n.T(ctx, "signed_out.title")) {
			<p>{ i18n.T(ctx, "signed_out.body", "project", v.Project) }</p>
			<a class="btn btn-primary btn-block" href={ templ.SafeURL(v.href(d, "/login")) }>{ i18n.T(ctx, "signed_out.sign_in") }</a>
		}
	}
}
