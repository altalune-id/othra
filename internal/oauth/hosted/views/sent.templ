package views

import (
	"strconv"

	"github.com/altalune-id/othra/internal/web/i18n"
	"github.com/altalune-id/othra/internal/web/layout"
)

// SentData is the "check your inbox" page's state; Email is empty when the flash cookie is gone, Client is the app the sign-in returns to.
type SentData struct {
	Site
	Client      string
	Email       string
	Minutes     int
	ReturnTo    string
	ResendToken string
	Resent      bool
}

// Sent tells the person to open the link from their inbox, with the same answer for every email.
templ Sent(d layout.LayoutData, v SentData) {
	@layout.Layout(titled(d, i18n.T(ctx, "sent.title"))) {
		<div class="flex w-full max-w-100 flex-col gap-5">
			<div class="flex flex-col gap-3">
				@iconTile(iconMailCheck())
				<h1 class="text-2xl font-semibold text-balance break-words">{ i18n.T(ctx, "sent.title") }</h1>
				<p>
					if v.Email != "" {
						@highlight(i18n.T(ctx, "sent.body"), "{email}", v.Email, "font-medium break-all")
					} else {
						{ i18n.T(ctx, "sent.body_no_email") }
					}
					@opensClient(v.Client)
				</p>
			</div>
			if v.Resent {
				@alertSuccess() {
					{ i18n.T(ctx, "sent.resent") }
				}
			}
			<ul class="flex flex-col gap-2 text-ui text-base-content/70">
				<li class="flex gap-2">
					@iconClock()
					<span>{ i18n.T(ctx, "sent.lifetime", "minutes", strconv.Itoa(v.Minutes)) }</span>
				</li>
				<li class="flex gap-2">
					@iconInbox()
					<span>{ i18n.T(ctx, "sent.spam_hint") }</span>
				</li>
			</ul>
			<div class="flex flex-wrap gap-2">
				if v.Email != "" {
					<form method="post" action={ v.href(d, "/login/resend") }>
						@layout.CSRFInput(v.ResendToken)
						<input type="hidden" name="email" value={ v.Email }/>
						if v.ReturnTo != "" {
							<input type="hidden" name="return_to" value={ v.ReturnTo }/>
						}
						<button class="btn btn-primary" type="submit">{ i18n.T(ctx, "sent.resend") }</button>
					</form>
				}
				<a class="btn" href={ templ.SafeURL(v.addAccount(d, v.ReturnTo)) }>{ i18n.T(ctx, "sent.change_email") }</a>
			</div>
		</div>
	}
}

templ opensClient(client string) {
	if client != "" {
		{ " " + i18n.T(ctx, "sent.opens", "client", client) }
	}
}
