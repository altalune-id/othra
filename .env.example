# development prints emails to the log (console mail driver) and allows http:// webhook URLs.
# For production, set production and configure mail, see the commented lines below.
OTHRA_ENV=development
# roles from scripts/db/provision.sh (the compose Postgres runs it on first start; dev-only passwords)
OTHRA_POSTGRES_DSN=postgres://othra_service:othra-dev-service-password@localhost:5432/othra?sslmode=disable
OTHRA_POSTGRES_MIGRATOR_DSN=postgres://othra_migrator:othra-dev-migrator-password@localhost:5432/othra?sslmode=disable
OTHRA_POSTGRES_MIGRATOR_ROLE=othra_owner
# generate: openssl rand -hex 32
OTHRA_HTTP_STATE_SECRET=
# generate: openssl rand -hex 32
OTHRA_SECRETS_ENCRYPTION_KEY=
# console prints emails to the log; refused in production
OTHRA_MAIL_DRIVER=console
# production mail (required when OTHRA_ENV=production):
# OTHRA_HTTP_BASE_URL=https://othra.example.com
# OTHRA_MAIL_DRIVER=smtp
# OTHRA_MAIL_FROM=Othra <noreply@example.com>
# OTHRA_MAIL_SMTP_HOST=
# or OTHRA_MAIL_DRIVER=resend with OTHRA_MAIL_RESEND_API_KEY=
