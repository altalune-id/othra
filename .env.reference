# Othra — auto-generated from config struct tags.
# DO NOT edit by hand. Run `go run ./cmd/gen-config-example` to regenerate.
#
# Awareness markers on each field (in [brackets] above the env var):
#   required   — must be non-empty for the app to boot
#   bootstrap  — set once at first-run; changing later has no effect or breaks things
#   secret     — never commit; use env vars or a secret store
#
# Fields split into two top-level sections:
#   BOOTSTRAP — locked at first boot, changing later is NOT SAFE
#   RUNTIME   — safe to change via env + restart
#
# RHS shows the built-in default when present. Secret fields intentionally
# emit no RHS value, even if a default exists internally.


# ════════════════════════════════════════════════════════════════════
#   BOOTSTRAP — set once at first boot; changing later is NOT SAFE
# ════════════════════════════════════════════════════════════════════
#
# Fields in this section lock in behavior for the lifetime of the deployment:
#   - Changing them after first boot has NO effect on already-persisted data
#     (e.g. postgres.schema and postgres.tablePrefix require SQL-level intervention).
#
# Read every line here BEFORE first `othra serve`. Set them deliberately.
#
# ────────────────────────────────────────────────────────────────────

# ─── db ───
# [bootstrap] db.rls.allowBypass
OTHRA_DB_RLS_ALLOW_BYPASS=false

# ─── env ───
# [required, bootstrap] env
OTHRA_ENV=production

# ─── mode ───
# [required, bootstrap] mode
OTHRA_MODE=selfhosted

# ─── postgres ───
# [bootstrap] postgres.schema
OTHRA_POSTGRES_SCHEMA=public
# [bootstrap] postgres.tablePrefix
OTHRA_POSTGRES_TABLE_PREFIX=


# ════════════════════════════════════════════════════════════════════
#   RUNTIME — safe to change via env + restart
# ════════════════════════════════════════════════════════════════════
#
# Fields in this section can be adjusted between deployments without
# affecting persisted data. Restarting the app picks up the new values.
#
# ────────────────────────────────────────────────────────────────────

# ─── api ───
# api.openapi.enabled
OTHRA_API_OPENAPI_ENABLED=true
# api.openapi.requireBasicAuth
OTHRA_API_OPENAPI_REQUIRE_BASIC_AUTH=true
# api.openapi.basicAuthUser
OTHRA_API_OPENAPI_BASIC_AUTH_USER=
# [secret] api.openapi.basicAuthPassword
OTHRA_API_OPENAPI_BASIC_AUTH_PASSWORD=

# ─── auth ───
# auth.mode
OTHRA_AUTH_MODE=local
# auth.basic.user
OTHRA_AUTH_BASIC_USER=
# [secret] auth.basic.password
OTHRA_AUTH_BASIC_PASSWORD=
# auth.genesis.email
OTHRA_AUTH_GENESIS_EMAIL=
# [secret] auth.genesis.password
OTHRA_AUTH_GENESIS_PASSWORD=
# auth.password.enabled
# OTHRA_AUTH_PASSWORD_ENABLED=
# auth.sessionTTL
OTHRA_AUTH_SESSION_TTL=24h
# auth.rememberLastUser
OTHRA_AUTH_REMEMBER_LAST_USER=true

# ─── cli ───
# cli.sessionFile
OTHRA_CLI_SESSION_FILE=~/.othra/session.json

# ─── compliance ───
# compliance.requireAcceptance
OTHRA_COMPLIANCE_REQUIRE_ACCEPTANCE=
# compliance.termsURL
OTHRA_COMPLIANCE_TERMS_URL=
# compliance.privacyURL
OTHRA_COMPLIANCE_PRIVACY_URL=
# compliance.termsUpdatedAt
OTHRA_COMPLIANCE_TERMS_UPDATED_AT=

# ─── db ───
# db.driver
OTHRA_DB_DRIVER=postgres
# db.autoMigrate
OTHRA_DB_AUTO_MIGRATE=true

# ─── endUsers ───
# endUsers.magicLink.ttl
OTHRA_END_USERS_MAGIC_LINK_TTL=15m
# endUsers.magicLink.resendAfter
OTHRA_END_USERS_MAGIC_LINK_RESEND_AFTER=60s
# endUsers.session.idle
OTHRA_END_USERS_SESSION_IDLE=720h
# endUsers.session.absolute
OTHRA_END_USERS_SESSION_ABSOLUTE=2160h
# endUsers.session.maxAccounts
OTHRA_END_USERS_SESSION_MAX_ACCOUNTS=20
# endUsers.csrf.maxAge
OTHRA_END_USERS_CSRF_MAX_AGE=1h

# ─── http ───
# [required] http.addr
OTHRA_HTTP_ADDR=:5150
# http.basePath
OTHRA_HTTP_BASE_PATH=
# http.baseURL
OTHRA_HTTP_BASE_URL=
# http.cookieSecure
OTHRA_HTTP_COOKIE_SECURE=true
# [secret] http.stateSecret
OTHRA_HTTP_STATE_SECRET=
# http.trustedProxyHops
OTHRA_HTTP_TRUSTED_PROXY_HOPS=0

# ─── install ───
# [secret] install.token
OTHRA_INSTALL_TOKEN=

# ─── keys ───
# keys.rsaBits
OTHRA_KEYS_RSA_BITS=2048
# keys.rotation.prePublish
OTHRA_KEYS_ROTATION_PRE_PUBLISH=10m
# keys.rotation.overlap
OTHRA_KEYS_ROTATION_OVERLAP=168h

# ─── mail ───
# mail.driver
OTHRA_MAIL_DRIVER=console
# mail.from
OTHRA_MAIL_FROM=
# mail.smtp.host
OTHRA_MAIL_SMTP_HOST=
# mail.smtp.port
OTHRA_MAIL_SMTP_PORT=587
# mail.smtp.username
OTHRA_MAIL_SMTP_USERNAME=
# [secret] mail.smtp.password
OTHRA_MAIL_SMTP_PASSWORD=
# mail.smtp.tls
OTHRA_MAIL_SMTP_TLS=starttls
# mail.smtp.timeout
OTHRA_MAIL_SMTP_TIMEOUT=10s
# [secret] mail.resend.apiKey
OTHRA_MAIL_RESEND_API_KEY=

# ─── mcp ───
# mcp.enabled
OTHRA_MCP_ENABLED=false
# mcp.appsUI
OTHRA_MCP_APPS_UI=

# ─── nats ───
# [secret] nats.url
OTHRA_NATS_URL=
# [secret] nats.token
OTHRA_NATS_TOKEN=
# nats.user
OTHRA_NATS_USER=
# [secret] nats.password
OTHRA_NATS_PASSWORD=
# nats.name
OTHRA_NATS_NAME=othra
# nats.connectTimeout
OTHRA_NATS_CONNECT_TIMEOUT=10s

# ─── oauth ───
# oauth.codeTTL
OTHRA_OAUTH_CODE_TTL=60s
# oauth.accessTokenTTL
OTHRA_OAUTH_ACCESS_TOKEN_TTL=15m
# oauth.idTokenTTL
OTHRA_OAUTH_ID_TOKEN_TTL=5m
# oauth.refresh.idle
OTHRA_OAUTH_REFRESH_IDLE=720h
# oauth.refresh.absolute
OTHRA_OAUTH_REFRESH_ABSOLUTE=2160h
# oauth.cimd.fetchTimeout
OTHRA_OAUTH_CIMD_FETCH_TIMEOUT=5s
# oauth.cimd.maxBytes
OTHRA_OAUTH_CIMD_MAX_BYTES=5120
# oauth.cimd.cacheMin
OTHRA_OAUTH_CIMD_CACHE_MIN=5m
# oauth.cimd.cacheMax
OTHRA_OAUTH_CIMD_CACHE_MAX=24h
# oauth.cimd.allowPrivateHosts
OTHRA_OAUTH_CIMD_ALLOW_PRIVATE_HOSTS=false

# ─── postgres ───
# [required, secret] postgres.dsn
OTHRA_POSTGRES_DSN=
# postgres.role
OTHRA_POSTGRES_ROLE=
# postgres.maxOpenConns
OTHRA_POSTGRES_MAX_OPEN_CONNS=
# postgres.maxIdleConns
OTHRA_POSTGRES_MAX_IDLE_CONNS=
# postgres.connMaxLifetime
OTHRA_POSTGRES_CONN_MAX_LIFETIME=
# postgres.connMaxIdleTime
OTHRA_POSTGRES_CONN_MAX_IDLE_TIME=
# postgres.connectTimeout
OTHRA_POSTGRES_CONNECT_TIMEOUT=5s
# postgres.connectBackoff
OTHRA_POSTGRES_CONNECT_BACKOFF=250ms
# [secret] postgres.reader.dsn
OTHRA_POSTGRES_READER_DSN=
# postgres.reader.role
OTHRA_POSTGRES_READER_ROLE=
# postgres.reader.maxOpenConns
OTHRA_POSTGRES_READER_MAX_OPEN_CONNS=
# postgres.reader.maxIdleConns
OTHRA_POSTGRES_READER_MAX_IDLE_CONNS=
# postgres.reader.connMaxLifetime
OTHRA_POSTGRES_READER_CONN_MAX_LIFETIME=
# postgres.reader.connMaxIdleTime
OTHRA_POSTGRES_READER_CONN_MAX_IDLE_TIME=
# [secret] postgres.migrator.dsn
OTHRA_POSTGRES_MIGRATOR_DSN=
# postgres.migrator.role
OTHRA_POSTGRES_MIGRATOR_ROLE=
# postgres.health.interval
OTHRA_POSTGRES_HEALTH_INTERVAL=30s
# postgres.health.timeout
OTHRA_POSTGRES_HEALTH_TIMEOUT=2s

# ─── queue ───
# queue.enabled
OTHRA_QUEUE_ENABLED=false
# queue.driver
OTHRA_QUEUE_DRIVER=nats

# ─── rateLimit ───
# rateLimit.driver
OTHRA_RATE_LIMIT_DRIVER=memory
# rateLimit.maxKeys
OTHRA_RATE_LIMIT_MAX_KEYS=100000
# rateLimit.auth.enabled
OTHRA_RATE_LIMIT_AUTH_ENABLED=true

# ─── redis ───
# [secret] redis.url
OTHRA_REDIS_URL=
# redis.keyPrefix
OTHRA_REDIS_KEY_PREFIX=othra:
# redis.maxConnections
OTHRA_REDIS_MAX_CONNECTIONS=10
# redis.minIdleConnections
OTHRA_REDIS_MIN_IDLE_CONNECTIONS=0
# redis.maxIdleTime
OTHRA_REDIS_MAX_IDLE_TIME=5m
# redis.connectTimeout
OTHRA_REDIS_CONNECT_TIMEOUT=5s
# redis.readTimeout
OTHRA_REDIS_READ_TIMEOUT=3s
# redis.writeTimeout
OTHRA_REDIS_WRITE_TIMEOUT=3s

# ─── resourceServers ───
# resourceServers.verification.interval
OTHRA_RESOURCE_SERVERS_VERIFICATION_INTERVAL=1h
# resourceServers.verification.staleAfter
OTHRA_RESOURCE_SERVERS_VERIFICATION_STALE_AFTER=24h
# resourceServers.verification.timeout
OTHRA_RESOURCE_SERVERS_VERIFICATION_TIMEOUT=5s
# resourceServers.verification.allowPrivateHosts
OTHRA_RESOURCE_SERVERS_VERIFICATION_ALLOW_PRIVATE_HOSTS=false

# ─── s3 ───
# s3.endpoint
OTHRA_S3_ENDPOINT=
# s3.browserEndpoint
OTHRA_S3_BROWSER_ENDPOINT=
# s3.region
OTHRA_S3_REGION=
# s3.bucket
OTHRA_S3_BUCKET=
# [secret] s3.accessKeyID
OTHRA_S3_ACCESS_KEY_ID=
# [secret] s3.secretAccessKey
OTHRA_S3_SECRET_ACCESS_KEY=
# s3.usePathStyle
OTHRA_S3_USE_PATH_STYLE=true
# s3.timeout
OTHRA_S3_TIMEOUT=10s

# ─── scheduler ───
# scheduler.enabled
OTHRA_SCHEDULER_ENABLED=true
# scheduler.shutdownGrace
OTHRA_SCHEDULER_SHUTDOWN_GRACE=30s

# ─── secrets ───
# secrets.encryptionKey
OTHRA_SECRETS_ENCRYPTION_KEY=

# ─── storage ───
# storage.driver
OTHRA_STORAGE_DRIVER=
# storage.app
OTHRA_STORAGE_APP=othra
# storage.publicBaseURL
OTHRA_STORAGE_PUBLIC_BASE_URL=
# storage.imageTransform
OTHRA_STORAGE_IMAGE_TRANSFORM=none
# storage.upload.urlTTL
OTHRA_STORAGE_UPLOAD_URL_TTL=10m
# storage.upload.pendingTTL
OTHRA_STORAGE_UPLOAD_PENDING_TTL=1h
# storage.private.signer
OTHRA_STORAGE_PRIVATE_SIGNER=presign
# storage.private.urlTTL
OTHRA_STORAGE_PRIVATE_URL_TTL=5m

# ─── telemetry ───
# telemetry.otlp.endpoint
OTHRA_TELEMETRY_OTLP_ENDPOINT=
# telemetry.otlp.protocol
OTHRA_TELEMETRY_OTLP_PROTOCOL=
# telemetry.otlp.insecure
OTHRA_TELEMETRY_OTLP_INSECURE=
# telemetry.otlp.headers
OTHRA_TELEMETRY_OTLP_HEADERS=
# telemetry.tracing.enabled
OTHRA_TELEMETRY_TRACING_ENABLED=
# telemetry.tracing.sampleRatio
OTHRA_TELEMETRY_TRACING_SAMPLE_RATIO=
# telemetry.metrics.enabled
OTHRA_TELEMETRY_METRICS_ENABLED=
# telemetry.metrics.exportInterval
OTHRA_TELEMETRY_METRICS_EXPORT_INTERVAL=30s
# telemetry.metrics.prometheus.enabled
OTHRA_TELEMETRY_METRICS_PROMETHEUS_ENABLED=
# telemetry.metrics.prometheus.addr
OTHRA_TELEMETRY_METRICS_PROMETHEUS_ADDR=:9090
# telemetry.metrics.prometheus.path
OTHRA_TELEMETRY_METRICS_PROMETHEUS_PATH=/metrics

# ─── upstreams ───
# upstreams.google.clientId
OTHRA_UPSTREAMS_GOOGLE_CLIENT_ID=
# [secret] upstreams.google.clientSecret
OTHRA_UPSTREAMS_GOOGLE_CLIENT_SECRET=
# upstreams.google.issuerOverride
OTHRA_UPSTREAMS_GOOGLE_ISSUER_OVERRIDE=
# upstreams.allowPrivateHosts
OTHRA_UPSTREAMS_ALLOW_PRIVATE_HOSTS=
