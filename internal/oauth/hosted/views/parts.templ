package views

import (
	"github.com/altalune-id/othra/internal/web/i18n"
	"github.com/altalune-id/othra/internal/web/layout"
)

templ svgIcon(class string) {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={ "shrink-0", class } aria-hidden="true">
		{ children... }
	</svg>
}

templ iconError() {
	@svgIcon("mt-0.5 size-4 text-error") {
		<circle cx="12" cy="12" r="10"></circle>
		<line x1="12" x2="12" y1="8" y2="12"></line>
		<line x1="12" x2="12.01" y1="16" y2="16"></line>
	}
}

templ iconChevron() {
	@svgIcon("size-4 text-base-content/70") {
		<path d="m9 18 6-6-6-6"></path>
	}
}

templ iconSignOut() {
	@svgIcon("size-4") {
		<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
		<polyline points="16 17 21 12 16 7"></polyline>
		<line x1="21" x2="9" y1="12" y2="12"></line>
	}
}

templ iconPlus() {
	@svgIcon("size-4") {
		<path d="M5 12h14"></path>
		<path d="M12 5v14"></path>
	}
}

templ iconMail(class string) {
	@svgIcon(class) {
		<rect width="20" height="16" x="2" y="4" rx="2"></rect>
		<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
	}
}

// iconTile is the square tile above a hosted page's title when the page shows an icon instead of the project's brand.
templ iconTile(icon templ.Component) {
	<span class="grid size-10 place-items-center rounded-field bg-base-200" aria-hidden="true">
		@icon
	</span>
}



templ iconDevice() {
	@svgIcon("size-4") {
		<rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect>
		<path d="M12 18h.01"></path>
	}
}

templ iconClock() {
	@svgIcon("size-4") {
		<circle cx="12" cy="12" r="10"></circle>
		<path d="M12 6v6h4"></path>
	}
}

templ iconInbox() {
	@svgIcon("size-4") {
		<polyline points="22 12 16 12 14 15 10 15 8 12 2 12"></polyline>
		<path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path>
	}
}

templ iconArrowRight() {
	@svgIcon("size-4 text-base-content/70") {
		<path d="M5 12h14"></path>
		<path d="m12 5 7 7-7 7"></path>
	}
}


templ iconCircle() {
	<div class="flex size-12 items-center justify-center self-center rounded-full bg-base-200">
		{ children... }
	</div>
}

templ iconCheck() {
	@svgIcon("mt-0.5 size-4 text-success") {
		<circle cx="12" cy="12" r="10"></circle>
		<path d="m9 12 2 2 4-4"></path>
	}
}

templ alertError(msg string) {
	<div role="alert" class="alert alert-error alert-soft text-base-content items-start">
		@iconError()
		<span>{ msg }</span>
	</div>
}

templ alertSuccess() {
	<div role="status" class="alert alert-success alert-soft text-base-content items-start">
		@iconCheck()
		<span class="min-w-0">
			{ children... }
		</span>
	</div>
}

templ withEmail(msg, email string) {
	@highlight(msg, "{email}", email, "break-all")
}

templ highlight(msg, placeholder, value, class string) {
	for _, p := range splitAround(msg, placeholder) {
		if p == placeholder {
			<span class={ class }>{ value }</span>
		} else {
			{ p }
		}
	}
}

templ accountTile(d layout.LayoutData, s Site, email, returnTo string) {
	<div class="flex items-center justify-between gap-3 rounded-box bg-base-200 px-4 py-3 text-sm">
		<span class="min-w-0">
			<span class="block text-xs text-base-content/70">{ i18n.T(ctx, "common.signing_in_as") }</span>
			<span class="block truncate font-medium" title={ email }>{ email }</span>
		</span>
		<a class="link shrink-0 text-xs" href={ templ.SafeURL(s.addAccount(d, returnTo)) }>{ i18n.T(ctx, "common.use_another") }</a>
	</div>
}

