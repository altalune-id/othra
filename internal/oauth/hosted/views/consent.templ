package views

import (
	"context"
	"slices"
	"strings"

	"github.com/altalune-id/othra/internal/web/i18n"
	"github.com/altalune-id/othra/internal/web/layout"
)

// ConsentData is the consent page: the app, the resource it asks for, the scopes, where the browser goes back to, and whether the person allowed it before.
type ConsentData struct {
	Site
	Client       string
	ClientHost   string
	RS           string
	RSIdentifier string
	Email        string
	UserSession  string
	ReturnTo     string
	ConsentToken string
	Scopes       []ConsentScope
	RedirectHost string
	Loopback     bool
	Remembered   bool
}

// ConsentScope is one requested scope: its catalog description, and whether the person allowed it before.
type ConsentScope struct {
	Scope         string
	Description   string
	AllowedBefore bool
}

func (s ConsentScope) label(ctx context.Context) string {
	switch s.Scope {
	case "openid":
		return i18n.T(ctx, "scope.openid")
	case "profile":
		return i18n.T(ctx, "scope.profile")
	case "email":
		return i18n.T(ctx, "scope.email")
	case "offline_access":
		return i18n.T(ctx, "scope.offline_access")
	}
	if s.Description != "" {
		return s.Description
	}
	return s.Scope
}

func (v ConsentData) ordered() []ConsentScope {
	out := slices.Clone(v.Scopes)
	slices.SortStableFunc(out, func(a, b ConsentScope) int {
		switch {
		case a.AllowedBefore == b.AllowedBefore:
			return 0
		case a.AllowedBefore:
			return 1
		default:
			return -1
		}
	})
	return out
}

func (v ConsentData) title(ctx context.Context) string {
	switch {
	case v.Remembered:
		return i18n.T(ctx, "consent.remembered_title", "client", v.Client)
	case v.RS != "":
		return i18n.T(ctx, "consent.title_rs", "client", v.Client, "rs", v.RS)
	default:
		return i18n.T(ctx, "consent.title_account", "client", v.Client, "project", v.Project)
	}
}

func (v ConsentData) rs() string {
	if v.RS != "" {
		return v.RS
	}
	return v.Project
}

func (v ConsentData) scopeList() string {
	out := make([]string, 0, len(v.Scopes))
	for _, s := range v.ordered() {
		out = append(out, s.Scope)
	}
	return strings.Join(out, " ")
}

func (v ConsentData) returnKey() string {
	if v.Remembered {
		return "consent.remembered_return"
	}
	return "consent.redirect_notice"
}

func (v ConsentData) allowLabel(ctx context.Context) string {
	if v.Remembered {
		return i18n.T(ctx, "continue.action", "client", v.Client)
	}
	return i18n.T(ctx, "consent.allow")
}

templ appMark(client string) {
	<span class="grid size-10 shrink-0 place-items-center rounded-field border border-base-300 bg-base-200 text-lg font-semibold" aria-hidden="true">{ initial(client) }</span>
}

// consentHeader shows the app's mark pointing at the project's tile, the title, and the app's return host in mono.
templ consentHeader(d layout.LayoutData, v ConsentData) {
	<div class="flex items-center gap-2">
		@appMark(v.Client)
		@iconArrowRight()
		if d.Brand != nil {
			@layout.BrandTile(d.Brand)
		}
	</div>
	<div class="flex flex-col gap-2">
		<h1 class="text-2xl font-semibold text-balance break-words">{ v.title(ctx) }</h1>
		<div class="flex flex-wrap items-center gap-2">
			<span class="font-mono text-base font-medium break-all">{ v.RedirectHost }</span>
			if v.ClientHost != "" {
				<span class="badge badge-sm badge-outline">
					@iconShieldAlert()
					{ i18n.T(ctx, "consent.unverified_title") }
				</span>
			}
		</div>
		if v.RS != "" && !v.Remembered {
			<p class="text-sm">
				<span class="font-medium">{ v.RS }</span>
				if v.RSIdentifier != "" {
					<span class="block font-mono text-xs break-all text-base-content/70">{ v.RSIdentifier }</span>
				}
			</p>
		}
		if v.ClientHost != "" {
			<p class="text-ui text-base-content/70">{ i18n.T(ctx, "consent.unverified_body", "project", v.Project, "host", v.ClientHost) }</p>
		}
		if v.Loopback {
			<p class="text-ui font-medium">{ i18n.T(ctx, "consent.loopback_warning") }</p>
		}
	</div>
}

// Consent asks the signed-in account to allow an app the requested scopes, or, when it allowed them before, to continue in one click.
templ Consent(d layout.LayoutData, v ConsentData) {
	@layout.Layout(titled(d, v.title(ctx))) {
		<div class="flex w-full max-w-112 flex-col gap-5">
			@consentHeader(d, v)
			if v.Remembered {
				<p class="break-words">{ i18n.T(ctx, "consent.remembered_body", "client", v.Client, "rs", v.rs()) }</p>
			}
			<div class="flex items-center justify-between gap-2 border-y border-base-300 py-2 text-ui">
				<span class="min-w-0">
					{ i18n.T(ctx, "common.signing_in_as") + " " }
					<span class="font-medium break-all" title={ v.Email }>{ v.Email }</span>
				</span>
				<a class="link shrink-0" href={ templ.SafeURL(v.addAccount(d, v.ReturnTo)) }>{ i18n.T(ctx, "common.use_another") }</a>
			</div>
			if !v.Remembered {
				<div class="flex flex-col gap-2">
					<h2 class="text-ui font-semibold">{ i18n.T(ctx, "consent.will_be_able", "client", v.Client) }</h2>
					<ul class="flex flex-col gap-1.5 text-sm">
						for _, s := range v.ordered() {
							<li class="flex items-start gap-2">
								@iconCheckSmall()
								<span class="min-w-0 flex-1">{ s.label(ctx) }</span>
								if s.AllowedBefore {
									<span class="badge badge-ghost badge-sm">{ i18n.T(ctx, "consent.allowed_before") }</span>
								}
							</li>
						}
					</ul>
					<details class="text-xs text-base-content/70">
						<summary class="cursor-pointer py-1">{ i18n.T(ctx, "consent.technical") }</summary>
						<dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-3 gap-y-1 pt-1 font-mono">
							<dt>scope</dt>
							<dd class="break-all">{ v.scopeList() }</dd>
							if v.RSIdentifier != "" {
								<dt>resource</dt>
								<dd class="break-all">{ v.RSIdentifier }</dd>
							}
						</dl>
					</details>
				</div>
			}
			<p class="flex items-start gap-1.5 text-ui text-base-content/70">
				@iconReturn()
				<span class="min-w-0 break-words">
					@highlight(i18n.T(ctx, v.returnKey()), "{host}", v.RedirectHost, "font-medium text-base-content")
				</span>
			</p>
			<form method="post" action={ v.href(d, "/consent") } class="flex flex-wrap gap-2">
				@layout.CSRFInput(v.ConsentToken)
				<input type="hidden" name="user_session" value={ v.UserSession }/>
				if v.ReturnTo != "" {
					<input type="hidden" name="return_to" value={ v.ReturnTo }/>
				}
				<button class="btn flex-1" type="submit" name="deny" value="1" formnovalidate>{ i18n.T(ctx, "consent.deny") }</button>
				<button class="btn btn-primary flex-1" type="submit">{ v.allowLabel(ctx) }</button>
			</form>
		</div>
	}
}
