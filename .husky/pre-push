#!/usr/bin/env sh
set -eu

node -e 'process.exit(+process.versions.node.split(".")[0] >= 24 ? 0 : 1)' 2>/dev/null || {
  echo "Node 24 is required (found $(node -v 2>/dev/null || echo none)); run: nvm alias default 24 — see .husky/README.md" >&2
  exit 1
}

zero=0000000000000000000000000000000000000000
unverified=0
echo "→ outgoing commits are signed"
while read -r _ local_sha _ remote_sha; do
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  # shellcheck disable=SC2086 # range holds rev-list arguments
  for c in $(git rev-list $range); do
    # only the header (up to the first blank line) can carry the signature
    if ! git cat-file commit "$c" | sed '/^$/q' | grep -q '^gpgsig'; then
      echo "commit $c is not signed; branch protection rejects unsigned commits." >&2
      echo "fix: git config commit.gpgsign true && git rebase --exec 'git commit --amend --no-edit -S' <base>" >&2
      exit 1
    fi
    if ! git verify-commit "$c" >/dev/null 2>&1; then
      unverified=$((unverified + 1))
    fi
  done
done
if [ "$unverified" -gt 0 ]; then
  echo "note: $unverified signed commit(s) could not be verified on this machine (GPG key not in the keyring or no gpg.ssh.allowedSignersFile); see .husky/README.md"
fi

echo "→ make lint"
make lint

echo "→ make comment-check"
make comment-check

echo "→ config examples match the config structs"
make config-check

echo "→ go test -race -shuffle=on ./..."
env -u GOROOT GOTOOLCHAIN=auto go test -race -shuffle=on ./...

echo "→ buf breaking against origin/main"
git fetch --quiet origin main 2>/dev/null || true
if git rev-parse --verify --quiet origin/main >/dev/null && git ls-tree -r --name-only origin/main | grep -q '\.proto$'; then
  pnpm exec buf breaking --against '.git#ref=refs/remotes/origin/main'
elif git rev-parse --verify --quiet origin/main >/dev/null; then
  echo "note: origin/main has no .proto files yet; skipping buf breaking"
else
  echo "note: no origin/main; skipping buf breaking"
fi

echo "→ pre-push OK"
