package layout

import "github.com/altalune-id/othra/internal/web/i18n"

// BrandTile is the project's logo, or its initial on the brand colour, in a square tile above a hosted page's title.
templ BrandTile(b *Brand) {
	if b.LogoURL != "" {
		<img src={ b.LogoURL } alt={ b.Name } class="size-10 rounded-field border border-base-300 bg-base-100 object-contain p-1" width="40" height="40" data-testid="brand-tile"/>
	} else if b.initial() != "" {
		<span class="grid size-10 place-items-center rounded-field bg-primary text-lg font-semibold text-primary-content" role="img" aria-label={ b.Name } data-testid="brand-tile">{ b.initial() }</span>
	}
}

// CSRFInput is the hidden field that carries a hosted form's CSRF token; it renders nothing without a token.
templ CSRFInput(token string) {
	if token != "" {
		<input type="hidden" name={ CSRFField } value={ token }/>
	}
}

// MailButton is an email's call to action, filled with primary (re-checked hex, else Othra's) and readable text on it.
templ MailButton(href, label, primary string) {
	<a href={ templ.SafeURL(href) } style={ mailButtonStyle(primary) }>{ label }</a>
}

// brandFooter holds the language select (hidden until lang.js shows it, and absent on a page that redirects), the project's legal links and the issuer host.
templ brandFooter(d LayoutData) {
	<footer class={ "flex w-full flex-wrap items-center justify-between gap-3 text-xs text-base-content/70", templ.KV("max-w-100", !d.Wide), templ.KV("max-w-112", d.Wide) }>
		<div class="flex flex-wrap items-center gap-3">
			if d.Refresh == "" {
				<label class="sr-only" for="lang">{ i18n.T(ctx, "common.language") }</label>
				<select id="lang" class="select select-xs w-28" data-lang-select data-path={ d.cookiePath() } hidden>
					for _, l := range i18n.Locales() {
						<option value={ l } selected?={ l == i18n.Locale(ctx) }>{ i18n.Name(l) }</option>
					}
				</select>
			}
			if d.Brand.TermsURL != "" || d.Brand.PrivacyURL != "" {
				<nav class="flex gap-3">
					if d.Brand.TermsURL != "" {
						@NewTabLink(d.Brand.TermsURL, i18n.T(ctx, "terms.terms_link"))
					}
					if d.Brand.PrivacyURL != "" {
						@NewTabLink(d.Brand.PrivacyURL, i18n.T(ctx, "terms.privacy_link"))
					}
				</nav>
			}
		</div>
		if d.Brand.IssuerHost() != "" {
			<span class="font-mono break-all">{ d.Brand.IssuerHost() }</span>
		}
	</footer>
	if d.Refresh == "" {
		<script type="module" src={ d.Static("/lang.js") }></script>
	}
}
