package layout

templ Layout(d LayoutData) {
	<!DOCTYPE html>
	<html lang={ d.lang() } data-theme="othra-light" data-brand?={ d.Brand != nil }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ d.Title } · { d.siteName() }</title>
			<link rel="icon" href={ d.Static("/favicon.ico") } sizes="any"/>
			<link rel="icon" type="image/png" sizes="32x32" href={ d.Static("/favicon-32x32.png") }/>
			<link rel="apple-touch-icon" href={ d.Static("/apple-touch-icon.png") }/>
			<link rel="stylesheet" href={ d.Static("/app.css") }/>
			if d.Refresh != "" {
				<meta http-equiv="refresh" content={ "0;url=" + d.Refresh }/>
			}
			@brandStyle(d.Brand)
		</head>
		<body class="min-h-dvh bg-base-100 text-base-content">
			<main class="flex min-h-dvh flex-col items-center justify-between gap-8 px-4 py-10">
				<div aria-hidden="true"></div>
				if d.Brand != nil {
					@brandScope(d.Brand) {
						{ children... }
					}
					@brandFooter(d.Brand)
				} else {
					{ children... }
					<div aria-hidden="true"></div>
				}
			</main>
		</body>
	</html>
}

templ Card(title string) {
	@CardWith(title, nil) {
		{ children... }
	}
}

// CardWith is Card with lead (an icon tile) in place of the project's brand tile above the title.
templ CardWith(title string, lead templ.Component) {
	<div class="flex w-full max-w-100 flex-col gap-5">
		<div class="flex flex-col gap-3">
			if lead != nil {
				@lead
			} else if b := brandFrom(ctx); b != nil {
				@BrandTile(b)
			}
			<h1 class="text-2xl font-semibold text-balance break-words">{ title }</h1>
		</div>
		{ children... }
	</div>
}

// Divider separates "Continue with Othra" from the password form below it.
templ Divider(label string) {
	<div class="divider my-0 text-xs text-base-content/70">{ label }</div>
}
