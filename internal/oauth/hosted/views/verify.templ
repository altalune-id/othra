package views

import (
	"net/url"

	"altalune.id/othra/apperror"
	"altalune.id/othra/internal/web/i18n"
	"altalune.id/othra/internal/web/layout"
)

// VerifyData is the magic link's confirm page; the link token itself stays in its cookie, out of the page.
type VerifyData struct {
	Site
	Email       string
	VerifyToken string
}

// Verify asks the person to continue before the link is used, so a mail scanner's GET signs nobody in.
templ Verify(d layout.LayoutData, v VerifyData) {
	@layout.Layout(titled(d, i18n.T(ctx, "verify.tab"))) {
		@layout.Card(i18n.T(ctx, "verify.title", "project", v.Project)) {
			if v.Email != "" {
				<p>
					@withEmail(i18n.T(ctx, "verify.body"), v.Email)
				</p>
			}
			<p class="text-sm text-base-content/70">{ i18n.T(ctx, "verify.warning") }</p>
			<form method="post" action={ v.href(d, "/login/verify") }>
				@layout.CSRFInput(v.VerifyToken)
				<button class="btn btn-primary btn-block" type="submit" autofocus>{ i18n.T(ctx, "common.continue") }</button>
			</form>
		}
	}
}

// LinkUnusableData is the page for an expired, used or unknown link.
type LinkUnusableData struct {
	Site
	ReturnTo string
}

// LinkUnusable says the link can't be used, with one message for every reason, and offers a new one.
templ LinkUnusable(d layout.LayoutData, v LinkUnusableData) {
	@layout.Layout(titled(d, i18n.T(ctx, "verify.invalid_title"))) {
		@layout.Card(i18n.T(ctx, "verify.invalid_title")) {
			<p>{ i18n.Error(ctx, apperror.CodeSignInLinkNotUsable) }</p>
			<a class="btn btn-primary btn-block" href={ templ.SafeURL(v.login(d, url.Values{"return_to": {v.ReturnTo}})) }>{ i18n.T(ctx, "verify.request_new") }</a>
		}
	}
}
